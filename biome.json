{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "scripts/**/*.mjs",
      "tests/**/*.ts",
      "*.ts",
      "*.mjs",
      "*.json",
      "!package-lock.json",
      "!.claude",
      "!.impeccable"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
