# Recruiter twin. Production uses Claude; local dev can use Ollama.
TWIN_PROVIDER=anthropic          # or "ollama"
TWIN_MODEL=claude-haiku-5-5      # with ollama: gpt-oss:20b
ANTHROPIC_API_KEY=
# Lead and unknown-question emails (https://resend.com). Without it, notifications are logged.
RESEND_API_KEY=
TWIN_FROM_EMAIL="Amit twin <onboarding@resend.dev>"
# Optional: shared rate limits across Vercel instances (https://upstash.com). Without it, limits are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Shows the chat on the home page. Set only where ANTHROPIC_API_KEY (or Ollama) is configured.
PUBLIC_TWIN_ENABLED=false
