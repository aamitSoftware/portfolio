---
/**
 * A looping reel of a real product, printed on its project's plate.
 * With `video` (files in /public), it plays a real screen recording of the product.
 * Without it, still frames crossfade with a slow camera drift.
 * WCAG 2.2.2: anything that moves for more than 5 seconds gets a pause control,
 * and reduced-motion visitors get a still frame.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Frame {
  src: ImageMetadata;
  alt: string;
  label: string;
}

interface Props {
  frames?: Frame[];
  ink: 'c' | 'm' | 'y';
  /** Seconds each frame is on screen. */
  hold?: number;
  video?: { mp4: string; webm: string; poster: string; label: string };
  caption: string;
  href?: string;
}

const { frames = [], ink, hold = 3.6, video, caption, href } = Astro.props;
const cycle = hold * Math.max(1, frames.length);
// Each frame owns 1/n of the cycle: fade in, hold, then fade out while the next frame fades in.
const n = Math.max(1, frames.length);
const slot = 100 / n;
const fade = Math.min(4, slot / 4);
const keyframes = `
@keyframes reel-fade-${n} {
  0% { opacity: 0 }
  ${fade.toFixed(2)}% { opacity: 1 }
  ${slot.toFixed(2)}% { opacity: 1 }
  ${(slot + fade).toFixed(2)}% { opacity: 0 }
  100% { opacity: 0 }
}
@keyframes reel-drift-${n} {
  0% { transform: scale(1) }
  ${(slot + fade).toFixed(2)}% { transform: scale(1.07) }
  100% { transform: scale(1.07) }
}`;
const origins = ['20% 30%', '80% 20%', '50% 80%', '15% 70%', '85% 75%', '50% 40%'];
---

<style is:global set:html={keyframes}></style>
<figure
  class="reel"
  style={`--panel: var(--proc-${ink}); --cycle: ${cycle}s; --n: ${n}; --fade-anim: reel-fade-${n}; --drift-anim: reel-drift-${n}`}
  data-reel
>
  <div class="panel">
    <div class="screen">
      {
        video ? (
          // No autoplay attribute: the script starts it, so reduced-motion visitors get the poster and a Play button.
          <video muted loop playsinline preload="metadata" poster={video.poster} aria-label={video.label} data-reel-video>
            <source src={video.webm} type="video/webm" />
            <source src={video.mp4} type="video/mp4" />
          </video>
        ) : (
          frames.map((f, i) => (
            <div class="frame" style={`--i: ${i}; --origin: ${origins[i % origins.length]}`}>
              <Image
                src={f.src}
                alt={i === 0 ? f.alt : ''}
                widths={[640, 960, 1280]}
                sizes="(min-width: 64rem) 640px, 92vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
              <span class="label" aria-hidden="true">{f.label}</span>
            </div>
          ))
        )
      }
    </div>
    <button type="button" class="toggle" aria-pressed="false" data-reel-toggle>
      <span class="when-playing">Pause</span>
      <span class="when-paused">Play</span>
      <span class="sr-only"> the product reel</span>
    </button>
  </div>
  <figcaption>
    {href ? <a href={href}>{caption}</a> : caption}
  </figcaption>
</figure>

<script is:inline>
  (() => {
    for (const reel of document.querySelectorAll('[data-reel]:not([data-wired])')) {
      reel.dataset.wired = '1';
      const btn = reel.querySelector('[data-reel-toggle]');
      const video = reel.querySelector('video');
      if (video) {
        reel.classList.add('has-video');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reel.classList.add('is-paused');
          btn.setAttribute('aria-pressed', 'true');
        } else {
          video.play().catch(() => {});
        }
      }
      btn.addEventListener('click', () => {
        const paused = reel.classList.toggle('is-paused');
        btn.setAttribute('aria-pressed', String(paused));
        if (video) paused ? video.pause() : video.play();
      });
    }
  })();
</script>

<style>
  .reel {
    margin: 0;
  }

  .panel {
    position: relative;
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--panel);
  }

  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f5f6f4;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.18),
      0 22px 44px -16px rgb(0 0 0 / 0.5);
  }

  .screen video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .frame {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .frame:first-child {
    opacity: 1;
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: var(--origin);
  }

  .label {
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    padding: 0.3rem 0.6rem;
    background: #000;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .frame {
      animation: var(--fade-anim) var(--cycle) linear infinite;
      animation-delay: calc(var(--i) * var(--cycle) / var(--n));
    }

    .frame:first-child {
      opacity: 0;
    }

    .frame :global(img) {
      animation: var(--drift-anim) var(--cycle) linear infinite;
      animation-delay: calc(var(--i) * var(--cycle) / var(--n));
    }

    .is-paused .frame,
    .is-paused .frame :global(img) {
      animation-play-state: paused;
    }
  }

  .toggle {
    position: absolute;
    right: clamp(1.5rem, 3.5vw, 2.5rem);
    bottom: clamp(1.5rem, 3.5vw, 2.5rem);
    min-height: 2.25rem;
    padding: 0 0.8rem;
    background: rgb(0 0 0 / 0.78);
    color: #fff;
    border: 0;
    border-radius: 2px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }

  .toggle:focus-visible {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  .when-paused,
  .is-paused .when-playing {
    display: none;
  }

  .is-paused .when-paused {
    display: inline;
  }

  /* Crossfading stills simply stop for reduced motion; a video keeps its Play button so it stays opt-in. */
  @media (prefers-reduced-motion: reduce) {
    .reel:not(.has-video) .toggle {
      display: none;
    }
  }

  figcaption {
    margin-top: 0.9rem;
    color: var(--meta);
    font-size: 0.875rem;
    font-stretch: 87.5%;
  }
</style>
