---
/**
 * A pipeline drawn as an ordered list: a real sequence, so the numbers carry meaning.
 * Steps may be "Label" or "Label: detail".
 */
interface Props {
  steps: string[];
  label: string;
  /** Marks the step where the loop returns to, if the flow is a cycle. */
  loopsTo?: number;
}

const { steps, label, loopsTo } = Astro.props;
const parsed = steps.map((s) => {
  const [head, ...rest] = s.split(':');
  return { head: head.trim(), detail: rest.join(':').trim() };
});
---

<figure class="flow">
  <ol aria-label={label}>
    {
      parsed.map((s, i) => (
        <li>
          <span class="n tnum">{i + 1}</span>
          <span class="head">{s.head}</span>
          {s.detail && <span class="detail">{s.detail}</span>}
        </li>
      ))
    }
  </ol>
  {
    loopsTo !== undefined && (
      <figcaption>
        After step {steps.length}, the flow goes back to step {loopsTo}: {parsed[loopsTo - 1]?.head}.
      </figcaption>
    )
  }
</figure>

<style>
  .flow {
    margin: 2rem 0;
  }

  ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 1rem 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .n {
    font-size: 0.8125rem;
    color: var(--meta);
  }

  .head {
    font-weight: 700;
    font-stretch: 100%;
    line-height: 1.25;
  }

  .detail {
    font-size: 0.9375rem;
    color: var(--meta);
    line-height: 1.4;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--meta);
  }
</style>
