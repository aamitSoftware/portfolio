---
/**
 * A proof print: whatever is slotted in is framed with crop marks, like a pull from the press.
 */
interface Props {
  caption?: string;
  class?: string;
}

const { caption, class: className } = Astro.props;
---

<figure class:list={['proof', className]}>
  <div class="frame">
    <span class="mark tl" aria-hidden="true"></span>
    <span class="mark tr" aria-hidden="true"></span>
    <span class="mark bl" aria-hidden="true"></span>
    <span class="mark br" aria-hidden="true"></span>
    <slot />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .proof {
    margin: 0;
  }

  .frame {
    position: relative;
    outline: 1px solid var(--rule);
    background: var(--paper);
  }

  .frame :global(img),
  .frame :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .mark {
    position: absolute;
    width: 0.75rem;
    height: 0.75rem;
    pointer-events: none;
  }

  .mark::before,
  .mark::after {
    content: '';
    position: absolute;
    background: var(--ink);
  }

  .mark::before {
    width: 100%;
    height: 1px;
  }

  .mark::after {
    width: 1px;
    height: 100%;
  }

  .tl {
    left: -1rem;
    top: -1rem;
  }
  .tl::before {
    bottom: 0;
  }
  .tl::after {
    right: 0;
  }
  .tr {
    right: -1rem;
    top: -1rem;
  }
  .tr::before {
    bottom: 0;
  }
  .tr::after {
    left: 0;
  }
  .bl {
    left: -1rem;
    bottom: -1rem;
  }
  .bl::before {
    top: 0;
  }
  .bl::after {
    right: 0;
  }
  .br {
    right: -1rem;
    bottom: -1rem;
  }
  .br::before {
    top: 0;
  }
  .br::after {
    left: 0;
  }

  figcaption {
    margin-top: 1.1rem;
    color: var(--meta);
    font-size: 0.875rem;
    font-stretch: 87.5%;
    line-height: 1.4;
  }
</style>
