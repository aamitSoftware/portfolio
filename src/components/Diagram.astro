---
/**
 * Boxes-and-arrows diagram drawn in the sheet's inks, so it follows Print and Screen mode.
 * Coordinates are in a 1280x800 viewBox (the same 16:10 frame as the screenshots).
 * Edges connect box edges: vertically when the boxes overlap in x, otherwise horizontally.
 */
export interface DiagramNode {
  id: string;
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
  sub?: string;
  /** Prints the box on a plate, slightly out of register, to mark the part this project is about. */
  accent?: 'c' | 'm' | 'y';
  dashed?: boolean;
}

export interface DiagramEdge {
  from: string;
  to: string;
  label?: string;
  dashed?: boolean;
  /** Draws arrowheads on both ends. */
  both?: boolean;
}

interface Props {
  title: string;
  desc: string;
  nodes: DiagramNode[];
  edges: DiagramEdge[];
}

const { title, desc, nodes, edges } = Astro.props;
const byId = new Map(nodes.map((n) => [n.id, n]));
const uid = `d${Math.random().toString(36).slice(2, 8)}`;

function anchor(a: DiagramNode, b: DiagramNode) {
  const ox = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x);
  const oy = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y);
  if (ox > 20) {
    const x = (Math.max(a.x, b.x) + Math.min(a.x + a.w, b.x + b.w)) / 2;
    return a.y < b.y
      ? { x1: x, y1: a.y + a.h, x2: x, y2: b.y, horizontal: false }
      : { x1: x, y1: a.y, x2: x, y2: b.y + b.h, horizontal: false };
  }
  if (oy > 20) {
    const y = (Math.max(a.y, b.y) + Math.min(a.y + a.h, b.y + b.h)) / 2;
    return a.x < b.x
      ? { x1: a.x + a.w, y1: y, x2: b.x, y2: y, horizontal: true }
      : { x1: a.x, y1: y, x2: b.x + b.w, y2: y, horizontal: true };
  }
  // Diagonal neighbours: leave from the side, arrive at the top or bottom.
  const x1 = a.x < b.x ? a.x + a.w : a.x;
  const y1 = a.y + a.h / 2;
  const x2 = b.x + b.w / 2;
  const y2 = a.y < b.y ? b.y : b.y + b.h;
  return { x1, y1, x2, y2, horizontal: true, elbow: true };
}

const lines = edges.map((e) => {
  const a = byId.get(e.from)!;
  const b = byId.get(e.to)!;
  const p = anchor(a, b);
  const d = 'elbow' in p ? `M${p.x1} ${p.y1} H${p.x2} V${p.y2}` : `M${p.x1} ${p.y1} L${p.x2} ${p.y2}`;
  const lx = 'elbow' in p ? (p.x1 + p.x2) / 2 : (p.x1 + p.x2) / 2;
  const ly = 'elbow' in p ? p.y1 - 12 : p.horizontal ? p.y1 - 14 : (p.y1 + p.y2) / 2;
  return { ...e, d, lx, ly, vertical: !p.horizontal };
});
---

<svg
  class="diagram"
  viewBox="0 0 1280 800"
  role="img"
  aria-labelledby={`${uid}-t ${uid}-d`}
  preserveAspectRatio="xMidYMid meet"
>
  <title id={`${uid}-t`}>{title}</title>
  <desc id={`${uid}-d`}>{desc}</desc>
  <defs>
    <marker id={`${uid}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="head" />
    </marker>
  </defs>

  {
    lines.map((l) => (
      <g class="edge">
        <path
          d={l.d}
          class:list={['wire', { dashed: l.dashed }]}
          marker-end={`url(#${uid}-a)`}
          marker-start={l.both ? `url(#${uid}-a)` : undefined}
        />
        {l.label && (
          <text
            x={l.vertical ? l.lx + 12 : l.lx}
            y={l.ly}
            class="edge-label"
            text-anchor={l.vertical ? 'start' : 'middle'}
            dominant-baseline={l.vertical ? 'middle' : 'auto'}
          >
            {l.label}
          </text>
        )}
      </g>
    ))
  }

  {
    nodes.map((n) => (
      <g class="node">
        {n.accent && (
          <>
            <rect x={n.x - 6} y={n.y + 5} width={n.w} height={n.h} class="plate" style={`fill: var(--plate-${n.accent})`} />
          </>
        )}
        <rect x={n.x} y={n.y} width={n.w} height={n.h} class:list={['box', { dashed: n.dashed, accented: n.accent }]} />
        <text x={n.x + 20} y={n.y + (n.sub ? n.h / 2 - 6 : n.h / 2 + 10)} class="label">
          {n.label}
        </text>
        {n.sub && (
          <text x={n.x + 20} y={n.y + n.h / 2 + 26} class="sub">
            {n.sub}
          </text>
        )}
      </g>
    ))
  }
</svg>

<style>
  .diagram {
    display: block;
    width: 100%;
    height: auto;
    background: var(--paper);
    font-family: var(--font-sans);
  }

  .box {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 2.5;
  }

  .box.accented {
    stroke-width: 3;
  }

  .plate {
    mix-blend-mode: var(--blend);
    opacity: 0.9;
  }

  .dashed {
    stroke-dasharray: 10 8;
  }

  .wire {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
  }

  .head {
    fill: var(--ink);
  }

  .label {
    fill: var(--ink);
    font-size: 30px;
    font-weight: 750;
    font-stretch: 105%;
  }

  .sub {
    fill: var(--meta);
    font-size: 21px;
  }

  .edge-label {
    fill: var(--meta);
    font-size: 20px;
    paint-order: stroke;
    stroke: var(--paper);
    stroke-width: 8px;
    stroke-linejoin: round;
  }
</style>
