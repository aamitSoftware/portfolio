---
import Sheet from '../../layouts/Sheet.astro';
import WorkIndex from '../../components/WorkIndex.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Sheet
  title="Work"
  description="Every project Amit Asher has on the press: live products, research, and work in progress."
>
  <p class="back"><a href="/">Back to the home page</a></p>
  <h1>Work</h1>
  <p class="intro">
    Everything I have on the press. Live work prints in register; building and planned projects
    are honest about where they stand.
  </p>
  <WorkIndex projects={projects} />
</Sheet>

<style>
  .back {
    margin: 0 0 2.5rem;
    font-size: 0.9375rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 9vw, 6rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.92;
  }

  .intro {
    max-width: 52ch;
    margin: 1.25rem 0 2.5rem;
    color: var(--meta);
  }
</style>
