{
  "ci": {
    "collect": {
      "staticDistDir": "./.vercel/output/static",
      "url": [
        "/index.html",
        "/work/bubble-up/index.html",
        "/work/agentgate/index.html"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 51200
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
